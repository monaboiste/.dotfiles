[alias]
  s = status
  c = commit
  ca = commit --amend

  wl = worktree list
  wa = worktree add
  wr = worktree remove

  lg = log --graph --abbrev-commit --decorate --format=format:'%C(brightyellow)%h%C(reset) - %C(green)(%ar)%C(reset) %s%C(reset) %C(red)- %an%C(reset)%C(yellow)%d%C(reset)'

  a = "!f() { \
    if [ $# -eq 0 ]; then \
      git add .; \
    else \
      git add \"$@\"; \
    fi \
  }; f"

  fo = "!f() { \
    url=$(git remote get-url origin); \
    if [[ $url =~ ^git@github[^:]*:(.+)\\.git$ ]]; then \
      path=${BASH_REMATCH[1]}; \
      url=\"https://github.com/$path\"; \
    elif [[ $url =~ ^https://(www\\.)?github\\.com/.+ ]]; then \
      :; \
    else \
      echo \"Not a GitHub repository\"; \
      exit 1; \
    fi; \
    open \"$url\"; \
  }; f"

  dl = -c diff.external=difft log -p --ext-diff
  ds = -c diff.external=difft show --ext-diff
  dd = -c diff.external=difft diff
  ddf = "!f() { \
    args=\"$*\"; \
    git diff $args --name-only | \
    FZF_DIFF_ARGS=\"$args\" \
    fzf \
      --preview 'git -c diff.external=\"difft --color always --display inline\" diff $FZF_DIFF_ARGS -- {}' \
      --preview-window='right,75%,wrap' \
      --height=100%; \
  }; f"

  sweep = "!f() { \
    delete=false; \
    merged_only=false; \
    for arg in \"$@\"; do \
      case \"$arg\" in \
        --delete) delete=true ;; \
        --merged) merged_only=true ;; \
        *) \
          echo \"Usage: git sweep [--merged] [--delete]\" >&2; \
          return 2; \
          ;; \
      esac; \
    done; \
    git fetch --prune || return; \
    targets=\"\"; \
    for branch in main master development; do \
      if git show-ref --verify --quiet \"refs/remotes/origin/$branch\"; then \
        targets=\"$targets origin/$branch\"; \
      fi; \
    done; \
    if [ \"$merged_only\" = true ] && [ -z \"$targets\" ]; then \
      echo \"No origin/main, origin/master or origin/development found.\" >&2; \
      return 1; \
    fi; \
    cutoff=$(date -v-3m +%s); \
    git for-each-ref \
      --format=\"%(refname:short) %(committerdate:unix)\" \
      refs/heads/ | \
    while read -r branch timestamp; do \
      [ \"$timestamp\" -ge \"$cutoff\" ] && continue; \
      case \"$branch\" in \
        main|master|development) continue ;; \
      esac; \
      merged=false; \
      for target in $targets; do \
        if git merge-base --is-ancestor \"$branch\" \"$target\" 2>/dev/null; then \
          merged=true; \
          break; \
        fi; \
      done; \
      [ \"$merged_only\" = true ] && [ \"$merged\" = false ] && continue; \
      if [ \"$delete\" = true ]; then \
        if [ \"$merged\" = true ]; then \
          if git branch -d \"$branch\" >/dev/null; then \
            echo \"Deleted: $branch [merged]\"; \
          else \
            echo \"Failed:  $branch [merged]\" >&2; \
          fi; \
        else \
          if git branch -D \"$branch\" >/dev/null; then \
            echo \"Deleted: $branch [unmerged]\"; \
          else \
            echo \"Failed:  $branch [unmerged]\" >&2; \
          fi; \
        fi; \
      else \
        if [ \"$merged\" = true ]; then \
          echo \"$branch [merged]\"; \
        else \
          echo \"$branch [unmerged]\"; \
        fi; \
      fi; \
    done; \
  }; f"

[tag]
  sort = -v:refname
[core]
  hooksPath = .githooks
  pager = less -I --mouse
[pager]
  difftool = true
[diff]
  tool = vimdiff
[difftool]
  prompt = false
[rebase]
  amendPreserveDate = true
