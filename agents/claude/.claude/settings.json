{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "syncClaudeAiSkills": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "default"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude/hooks/herdr-agent-state.sh\" ]; then bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "postman@claude-plugins-official": true,
    "ste@ctotheameron": true
  },
  "extraKnownMarketplaces": {
    "ctotheameron": {
      "source": {
        "source": "github",
        "repo": "ctotheameron/agent-ste"
      }
    }
  },
  "outputStyle": "keep-it-simple",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-haiku-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 100000
    },
    "bedrock/openai.gpt-6.1-sol": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 800000,
  "theme": "auto"
}
